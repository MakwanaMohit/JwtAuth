# Server Port
SERVER_PORT=8080

# Application Identity
APP_NAME=JwtAuth

# MongoDB Configuration URI
MONGODB_URI=mongodb://localhost:27017/jwtauth
# For authenticated MongoDB in production:
# MONGODB_URI=mongodb://username:password@hostname:27017/jwtauth?authSource=admin

# Security Keys & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_min_256_bits_here

# CORS Allowed Origins (Comma-Separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
